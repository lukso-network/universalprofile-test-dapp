{
	"name": "universalprofile-test-dapp",
	"version": "0.1.54",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "NODE_OPTIONS='--preserve-symlinks' vite --mode development",
		"dev:link": "yarn link ../tools-up-provider/packages/up-provider",
		"dev:unlink": "yarn unlink @lukso/up-provider && yarn install --check-cache",
		"build": "vue-tsc --noEmit && vite build",
		"docs": "cd packages/tools-lukso-provider && yarn docs",
		"build:cloudflare": "yarn lint:js && yarn lint:css && yarn lint:format && yarn lint:types && yarn test && yarn build",
		"preview": "vite preview",
		"test": "jest --silent --verbose",
		"lint": "npm-run-all --aggregate-output --continue-on-error --parallel 'lint:*!(fix)'",
		"lint:js": "eslint src --ext .js,.ts,.vue",
		"lint:css": "stylelint \"**/*.{css,scss,vue}\"",
		"lint:format": "prettier --check --log-level=warn .",
		"lint:format:fix": "prettier --write --log-level=warn .",
		"lint:types": "tsc --noEmit",
		"prepare": "husky install"
	},
	"dependencies": {
		"@erc725/erc725.js": "0.28.1",
		"@lukso/lsp-factory.js": "^3.3.1",
		"@lukso/lsp-smart-contracts": "^0.16.7",
		"@lukso/up-provider": "./lukso-up-provider-0.3.5-test8.tgz",
		"@lukso/web3-onboard-config": "1.1.2",
		"@pinata/sdk": "^2.1.0",
		"@types/isomorphic-fetch": "^0.0.39",
		"@walletconnect/ethereum-provider": "2.21.8",
		"@walletconnect/sign-client": "2.21.8",
		"@walletconnect/types": "2.21.8",
		"@walletconnect/utils": "2.21.8",
		"@web3-onboard/core": "^2.24.1",
		"@web3-onboard/injected-wallets": "^2.11.3",
		"@web3modal/ethereum": "2.7.1",
		"@web3modal/standalone": "2.4.3",
		"bulma": "0.9.4",
		"eth-rpc-errors": "4.0.3",
		"ethers": "^5.8.0",
		"filesize": "10.1.6",
		"https-browserify": "1.0.0",
		"isomorphic-fetch": "^3.0.0",
		"isomorphic-webcrypto": "^2.3.8",
		"siwe": "1.1.6",
		"tslib": "^2.8.1",
		"vue": "^3.5.20",
		"vue-router": "4.5.1",
		"wagmi": "^1.4.13",
		"web3": "1.10.4",
		"web3-eth-contract": "1.10.4",
		"wrangler": "^4.32.0"
	},
	"devDependencies": {
		"@depay/web3-mock": "^14.19.1",
		"@testing-library/jest-dom": "6.8.0",
		"@testing-library/user-event": "14.6.1",
		"@testing-library/vue": "8.1.0",
		"@types/jest": "30.0.0",
		"@typescript-eslint/eslint-plugin": "6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"@vitejs/plugin-vue": "^5.2.4",
		"@vue/compiler-sfc": "3.5.20",
		"@vue/vue3-jest": "28.1.0",
		"babel-jest": "^30.0.5",
		"eslint": "8.57.1",
		"eslint-config-prettier": "9.1.2",
		"eslint-plugin-prettier": "^5.5.4",
		"eslint-plugin-vue": "9.33.0",
		"husky": "^8.0.3",
		"jest": "28.1.3",
		"jest-environment-jsdom": "28.1.3",
		"lint-staged": "^13.3.0",
		"lokijs": "^1.5.12",
		"npm-run-all": "4.1.5",
		"postcss-html": "^1.8.0",
		"prettier": "3.6.2",
		"sass": "1.90.0",
		"sharp": "^0.34.3",
		"stream-browserify": "3.0.0",
		"stream-http": "3.2.0",
		"stylelint": "15.11.0",
		"stylelint-config-prettier": "9.0.5",
		"stylelint-config-recommended-vue": "1.6.1",
		"stylelint-config-standard-scss": "10.0.0",
		"ts-jest": "28.0.8",
		"typescript": "^5.9.2",
		"util": "0.12.5",
		"vite": "^4.5.14",
		"vite-plugin-pwa": "^1.0.3",
		"vue-loader": "17.4.2",
		"vue-tsc": "^2.2.12",
		"workbox-window": "^7.3.0"
	},
	"lint-staged": {
		"*.{ts,js,vue}": [
			"prettier --list-different",
			"eslint"
		],
		"*.json": "prettier --list-different",
		"*.ya?ml": "prettier --list-different",
		"*.{scss,css,vue}": [
			"prettier --list-different",
			"stylelint"
		]
	},
	"engines": {
		"node": "18.12.1"
	},
	"packageManager": "yarn@4.9.2",
	"resolutions": {
		"wagmi": "~1.2.0"
	}
}
